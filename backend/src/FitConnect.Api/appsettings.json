{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": {
    "ReactApp": "http://localhost:5173"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fitconnect;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "FitConnect",
    "Audience": "FitConnectClients",
    "SigningKey": "dev-only-signing-key-replace-with-32+-char-random-secret",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "RootPath": "../../uploads",
    "PublicPathPrefix": "/uploads"
  }
}
